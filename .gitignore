# Rust build artifacts
/target/
worktrees/
# Loop worker runtime artifacts (written into worktree roots; also matched
# inside worktrees/ above, but keep them ignored if ever written to the main
# checkout by a stray agent or a pre-commit autostash cycle)
.agent.log
.agent.jsonl
.worker.log
.spawn.log
# Stray agent cargo target dirs (CARGO_TARGET_DIR set to <dir>/target-<name>
# by workers). Never tracked; ignoring keeps wt_guard from stashing 11k
# build-artifact files (~500 MB) around every on-main agent run.
/target-*/
# Sandbox agent cargo registry cache (CARGO_HOME override landed in the
# workdir during task-092; wip auto-commits swept 15.8k files onto the
# worker branch). Never tracked.
/.cargo-home/
.cargo-home/
.ralph-loop-status.md

# Nix build outputs
/result
/result-*

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Environment
.env
.env.local

# Pre-commit cache
.pre-commit-cache/
# Stray root package-lock.json: some review/verifier tooling invokes npm from
# the repo root (no package.json there), and npm writes an empty lockfile stub.
# The wip sweep (`scripts/dev-remote.sh` "preserve sandbox attempt") commits
# any untracked file it finds, which turned this generated artifact into a
# task-labeled source change and got two integrations rejected ("review cannot
# approve its own source edits"). Ignore it so the sweep never captures it.
# Anchored to the repo root: /package-lock.json does NOT match
# web/package-lock.json or any other tracked subdirectory lockfile.

/package-lock.json

# SQLite databases (development)
*.db
*.sqlite
*.sqlite3
.gyre-dev-controller/

# Web app
web/node_modules/

# Agent runner
docker/gyre-agent/node_modules/
repos/
crates/gyre-server/repos/

# Runtime snapshots (created by POST /api/v1/admin/snapshot)
snapshots/
crates/gyre-server/snapshots/
scripts/node_modules/
node_modules/
__pycache__/
*.py[cod]

# Compiled binaries in scripts/
scripts/go-callgraph/go-callgraph

# Test results
web/test-results/
# Local agent goal notes (secrets — never commit)
OPENSHELL-GOAL.md
